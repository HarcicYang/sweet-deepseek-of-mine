{
  "name": "@sweet-deepseek/server",
  "version": "0.0.0",
  "description": "Sweet DeepSeek O'Mine 服务端",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "node --env-file-if-exists=../../.env --import tsx src/index.ts",
    "worker:dev": "wrangler dev",
    "worker:deploy": "wrangler deploy",
    "worker:types": "wrangler types src/worker-configuration.d.ts",
    "worker:migrate:local": "wrangler d1 migrations apply sweet-deepseek-o-mine --local",
    "worker:migrate:remote": "wrangler d1 migrations apply sweet-deepseek-o-mine --remote",
    "test": "node --import tsx --test src/*.test.ts",
    "type": "tsc -p tsconfig.json",
    "lint": "oxlint src"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.8",
    "@sweet-deepseek/contracts": "workspace:*",
    "hono": "^4.13.18"
  },
  "devDependencies": {
    "@types/node": "~20.9.2",
    "tsx": "^4.23.15",
    "wrangler": "4.162.0"
  }
}
